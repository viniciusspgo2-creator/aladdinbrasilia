# Banco de dados Neon (obrigatório para produção)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Chave longa, aleatória, no mínimo 32 caracteres; gere com: openssl rand -base64 48
SESSION_SECRET=""
# Crie admin em: npm run db:seed (ADMIN_PASSWORD requerido)
ADMIN_EMAIL="admin@seu-dominio.com"
ADMIN_PASSWORD=""
# Armazenamento R2 (recomendado) / S3 compatível
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
# Apenas configuração documental, NÃO há endpoints Mercus inventados
MERCUS_API_URL=""
MERCUS_API_KEY=""
# Número comercial Aladdin, somente dígitos com DDI (ex. 5561999999999)
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
